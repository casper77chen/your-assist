# ── 核心（必填）─────────────────────────────────────────────
# LINE Messaging API（兩個都從 LINE Developers Console 拿）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Claude（Anthropic API key，或相容的 OpenAI-style endpoint）
ANTHROPIC_API_KEY=
# 可選：預設 opus，想省錢/加速可設 sonnet 或 haiku
# CLAUDE_MODEL=opus

# 服務埠（本機測試用；雲端平台通常會自動注入 PORT）
PORT=3000

# ── 把它變成「你的」助理（強烈建議填）──────────────────────────
ASSISTANT_NAME=           # 助理叫什麼（例：小幫）
OWNER_NAME=               # 怎麼稱呼你（例：阿明）
# OWNER_NICKNAME=         # 回覆時偏好的暱稱（沒設就用 OWNER_NAME）
# ASSISTANT_PERSONA=      # 口吻補充（自由填，例：偶爾可以幽默一點）
# OWNER_ABBREVIATIONS=    # 常用簡稱對照，例：con=人脈庫,wiki=知識庫
# OWNER_LINE_USER_ID=     # 主動推播（晨報/週回顧）的收件人；先傳訊給助理，開 /brief?key=SETUP_KEY 會顯示

# 保護一次性 OAuth/setup 路由用的密鑰（自己設一個隨機字串）
# SETUP_KEY=

# ── 能力（選填，填了才啟用對應功能）─────────────────────────────
# Google（Calendar / Sheets）：跑 /oauth/connect?key=SETUP_KEY 授權拿 refresh token
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# 長期記憶 / 待辦（Google Sheets）：開 /setup/memory?key=SETUP_KEY 自動建表並回傳 ID
# MEMORY_SPREADSHEET_ID=

# 人脈管理（Connectome）：用你自己的 Connectome 帳密；/setup/connectome?key=SETUP_KEY 驗證
# CONNECTOME_EMAIL=
# CONNECTOME_PASSWORD=
# CONNECTOME_BASE_URL=https://connectome.com.tw  # 可選，預設即此

# 知識庫（決策日誌／個人知識庫，預設關閉；不需要就整段留空）
# 二選一：MyWiki 或 Obsidian。兩個都沒設＝知識庫能力關閉。
# 想強制指定用哪個 provider 才設 KNOWLEDGE_PROVIDER（mywiki / obsidian）；
# 不設時自動挑「第一個有設好憑證的」（mywiki 優先）。
# KNOWLEDGE_PROVIDER=mywiki
#
# 選項 A — MyWiki（需自己另外部署 MyWiki 專案；capture + 查詢）
# MYWIKI_BASE_URL=
# MYWIKI_API_KEY=
#
# 選項 B — Obsidian（規劃中，尚未開放：等同步後端拍板 Google Drive / GitHub / Dropbox）
#   屆時透過 vault 同步的雲端後端寫 .md，v1 只做存筆記、不支援查詢。

# 語音速記（LINE 語音 → Whisper 轉文字）
# OPENAI_API_KEY=

# 行事曆讀取 iCloud/Apple 公開 .ics（可逗號分隔多本）
# ICAL_FEED_URL=

# 主動推播時間（台北時區，可選）
# BRIEFING_TIME=07:00      # 每日晨報
# WEEKLY_TIME=SUN 21:00    # 週回顧

# 個人快捷（會議室 / 同事），不想改 code 時用（格式見 shortcuts.js）
# ROOMS_JSON=
# CONTACTS_JSON=

# ── 公開 Demo 護欄（只有想開放給人試玩、用「你一把付費 key」時才設）──────
# 設了 DEMO_DAILY_LIMIT（>0）就啟用：每位 LINE 使用者每天的訊息上限，防止刷爆/燒錢。
# DEMO_DAILY_LIMIT=10
# DEMO_GLOBAL_DAILY_LIMIT=300   # 選用：全站每天總上限
# DEMO_ALLOWLIST=               # 不受限的 LINE userId（逗號分隔，放你自己）
